{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/hotel-performance-report?type=weekly",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/hotel-performance-report?type=monthly",
      "schedule": "0 12 1 * *"
    },
    {
      "path": "/api/cron/cleanup-orphaned-uploads",
      "schedule": "0 7 * * *"
    }
  ]
}
