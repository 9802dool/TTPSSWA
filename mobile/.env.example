# Public site URL (no trailing slash). Used at build time.
# Production: your deployed Next.js URL (e.g. Vercel).
# Local dev on same Wi‑Fi: http://YOUR_PC_LAN_IP:3000
EXPO_PUBLIC_SITE_URL=https://your-site.example.com

# Optional: Cloudflare Turnstile site key for spam protection in the mobile app.
# If set on the Next.js backend (TURNSTILE_SECRET_KEY + NEXT_PUBLIC_TURNSTILE_SITE_KEY),
# also set here to enable Turnstile in the mobile forms.
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
