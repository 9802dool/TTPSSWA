datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  UNVERIFIED
  BASIC_USER
  FINANCIAL_MEMBER
  ADMIN
}

enum RoomCategory {
  PRESIDENTIAL_SUITE
  SINGLE_OCCUPANCY
  DOUBLE_OCCUPANCY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Web Authentication Account
model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  serviceNumber String   @unique
  passwordHash  String
  role          UserRole @default(UNVERIFIED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  membershipApplication MembershipApplication?
}

// Decoupled Formal Membership & Salary Deduction
model MembershipApplication {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stationDivision         String
  nisNumber               String
  bankName                String
  accountNumber           String
  salaryDeductionApproved Boolean  @default(false)
  signatureUrl            String?
  status                  String   @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedAt             DateTime @default(now())
}

model HotelBooking {
  id              String        @id @default(cuid())
  guestName       String
  serviceNumber   String
  email           String
  phone           String
  roomCategory    RoomCategory
  checkIn         DateTime
  checkOut        DateTime
  guests          Int           @default(1)
  meals           String[]      @default([])
  specialRequests String?
  status          BookingStatus @default(CONFIRMED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([roomCategory, status, checkIn, checkOut])
}
